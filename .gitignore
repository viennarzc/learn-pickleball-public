# Local QA comparison captures can include reference-inspired source material.
qa-*.jpg

# Local platform state and installed dependencies.
/.vercel/
/node_modules/

# Build output and tool caches.
/build/
/dist/
/out/
/.next/
/.turbo/
/.vite/
/.parcel-cache/
/.cache/
/coverage/
/.nyc_output/
/logs/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Local editor and assistant configuration. Keep shared VS Code recommendations.
/.idea/
/.vscode/*
!/.vscode/extensions.json
/.agents/
/.codex/
/.cursor/
/.claude/

# Local scratch files.
/tmp/
/temp/
*.tmp
*.bak
*.orig

# Local synthetic UI/UX feedback and supporting screenshots.
/local-feedback/
/design-review/

# Internal audit notes, raw research, and private operational documentation.
/docs/internal/
/docs/research/private/
/docs/operations/private/

# Operating-system and editor leftovers.
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/
.TemporaryItems/
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Package-manager logs and local caches.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# Keep local credentials and private key material out of commits.
.env
.env.*
!.env.example
.envrc
.npmrc
!.npmrc.example
/.aws/
/.ssh/
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Generated public configuration.
/support/config.js
